# ---- Copy to .env.local and fill in. Never commit .env.local ----

# Token mint addresses (Solana). Leave blank until you have them.
# Public so the browser can build swap transactions and link to Solscan.
NEXT_PUBLIC_MINT_VG=
NEXT_PUBLIC_MINT_VS=
NEXT_PUBLIC_MINT_VB=
NEXT_PUBLIC_MINT_VC=

# Network: mainnet-beta or devnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Helius (https://dashboard.helius.dev). SERVER ONLY: used for RPC, holders, transactions.
HELIUS_API_KEY="db5281d2-cfaa-4f64-8c59-c274ea80dc5a"

# Jupiter swap API. Base URL may need an API key; see https://dev.jup.ag
JUPITER_API_URL="https://lite-api.jup.ag/swap/v1"
JUPITER_API_KEY="jup_b63acfd981a3bd8db00494fb06840f041d133ac85efc877a0a95a1238bc7cfc6"

# DexScreener and GeckoTerminal need no key.


# Admin auth (used in the next phase). Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="YtCrnQ0heRYBZpQ0wRE6h/Qj9GaVSaFNqDbZFuRFubE="
ADMIN_WALLET_ALLOWLIST="AtDJqUqK73MASUdCmxv75CJ1LKjN9ogCkJJULSDTr7bz"

# Secret for /api/cron/snapshot (Vercel sends it automatically)
