# DIRECT_URL = Direct connection (5432), or the Session pooler string if your network has no IPv6
DIRECT_URL="postgresql://postgres.moqjcbuxhtpamkjyrdpj:s2HfoxjWSYii8plg@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
